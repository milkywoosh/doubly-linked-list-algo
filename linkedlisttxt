package main

import "fmt"

type LinkedList struct {
	current int
	next  *LinkedList
}

func (ll *LinkedList) Add(val int) {
	if ll.next == nil {
		ll.next = &LinkedList{current: val}
		return
	} else {
		ll.next.Add(val)
		return
	}
}

func (ll *LinkedList) Print() {
	current := ll
	for current != nil {
		fmt.Printf("%d\n", current.current)
		current = current.next
	}
}

func (ll *LinkedList) Prepend(val int) *LinkedList {
	// insert value at before the first node

	newNode := &LinkedList{
		current: val,
		next:  ll,
	}

	return newNode

}


